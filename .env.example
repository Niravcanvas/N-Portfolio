# ─────────────────────────────────────────────────────────────────────────────
# Portfolio — environment variables
# Copy to `.env.local` (dev) or set on the VPS (prod). NEVER commit real values.
# Only NEXT_PUBLIC_* vars are exposed to the browser — keep everything else secret.
# All backend vars are OPTIONAL: if unset, that service degrades gracefully
# (the site still builds and runs; the contact form/DB/email just no-op).
# ─────────────────────────────────────────────────────────────────────────────

# Public site origin — used for canonical URLs, OG tags, sitemap, robots.
NEXT_PUBLIC_SITE_URL="https://niravthakur.in"

# Public base URL of the Cloudflare R2 bucket (custom domain or r2.dev URL).
# Images served from here are allowlisted for next/image + CSP.
NEXT_PUBLIC_CDN_URL="https://cdn.niravthakur.in"

# ── MongoDB (internal connection string on the VPS) ──────────────────────────
MONGODB_URI="mongodb://user:pass@127.0.0.1:27017/portfolio?authSource=admin"

# ── Redis (rate limiting) ────────────────────────────────────────────────────
REDIS_URL="redis://127.0.0.1:6379"

# ── Resend (transactional email for the contact form) ────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
CONTACT_FROM_EMAIL="Portfolio <contact@niravthakur.in>"   # must be a verified Resend sender
CONTACT_TO_EMAIL="niravthakur@icloud.com"                  # where messages are delivered

# ── Cloudflare R2 (S3-compatible object storage for images) ──────────────────
R2_ACCOUNT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_ACCESS_KEY_ID="xxxxxxxxxxxxxxxxxxxx"
R2_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_BUCKET="portfolio-images"
# Optional explicit endpoint; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT="https://<account>.r2.cloudflarestorage.com"

# ── Privacy / abuse protection ───────────────────────────────────────────────
# Min 16 chars. Used to salt-hash client IPs for rate-limit keys (raw IPs never stored).
IP_HASH_SALT="change-me-to-a-long-random-string"

# ── Misc ─────────────────────────────────────────────────────────────────────
LOG_LEVEL="info"                 # debug | info | warn | error
# SKIP_ENV_VALIDATION="true"     # set during CI builds without real secrets
